#!/bin/sh

set -u

OUT=/tmp/openmanet-health
: > "$OUT"
pass=0
warn=0
fail=0

result() {
	local level="$1" name="$2" detail="$3"
	printf '%s %s: %s\n' "$level" "$name" "$detail" >> "$OUT"
	logger -t openmanet-health "$level $name: $detail" 2>/dev/null || true
	case "$level" in
		PASS) pass=$((pass + 1)) ;;
		WARN) warn=$((warn + 1)) ;;
		FAIL) fail=$((fail + 1)) ;;
	esac
}

run() {
	local name="$1"; shift
	if "$@" >/dev/null 2>&1; then
		result PASS "$name" 'ok'
	else
		result FAIL "$name" 'failed'
	fi
}

overlay_mount="$(awk '$2 == "/overlay" { print; exit }' /proc/mounts 2>/dev/null || true)"
storage_mount="$(awk '$2 == "/tmp/overlay" { print; exit }' /proc/mounts 2>/dev/null || true)"
[ -n "$overlay_mount" ] && result PASS 'overlay-mounted' "$overlay_mount" || result FAIL 'overlay-mounted' 'no /overlay mount'
[ -n "$storage_mount" ] && result PASS 'storage-mounted' "$storage_mount" || result FAIL 'storage-mounted' 'no underlying overlay filesystem mount'
echo "$storage_mount" | grep -q ' f2fs ' && result PASS 'f2fs-overlay' 'F2FS is mounted' || result WARN 'f2fs-overlay' 'overlay is not F2FS'

overlay_dev="$(echo "$storage_mount" | awk '{print $1}')"
[ -n "$overlay_dev" ] && [ -b "$overlay_dev" ] && result PASS 'root-storage' "$overlay_dev" || result FAIL 'root-storage' 'block device not identified'
[ -w /overlay ] && result PASS 'overlay-writable' 'yes' || result FAIL 'overlay-writable' 'not writable'

feed_fail=0
if [ -r /etc/opkg/distfeeds.conf ]; then
	while read -r _ _url _rest; do
		[ -n "${_url:-}" ] || continue
		case "$_url" in \#*) continue ;; esac
		if command -v uclient-fetch >/dev/null 2>&1 && ! uclient-fetch -q -O /tmp/openmanet-packages.gz "${_url%/}/Packages.gz"; then
			feed_fail=1
		fi
	done < /etc/opkg/distfeeds.conf
fi
[ "$feed_fail" -eq 0 ] && result PASS 'package-feeds' 'configured repositories responded' || result WARN 'package-feeds' 'one or more repositories unavailable'

run 'batman-module' sh -c 'lsmod | grep -q "^batman_adv[[:space:]]"'
run 'bat0-interface' ip link show bat0
run 'batman-hard-interface' batctl meshif bat0 if
if [ -d /sys/class/net/br-ahwlan/brif/bat0 ]; then
	result PASS 'bat0-bridge' 'bat0 is in br-ahwlan'
else
	result FAIL 'bat0-bridge' 'bat0 is not in br-ahwlan'
fi
if batctl meshif bat0 n 2>/dev/null | grep -q ESTABLISHED; then
	result PASS 'mesh-peer' 'BATMAN neighbor established'
else
	result WARN 'mesh-peer' 'no established BATMAN neighbor yet'
fi
if batctl meshif bat0 o 2>/dev/null | grep -q -v '^Reading'; then
	result PASS 'originator-table' 'BATMAN originator data present'
else
	result WARN 'originator-table' 'no originator route learned yet'
fi

mesh_if="$(iw dev 2>/dev/null | awk '$1 == "Interface" { i=$2 } $1 == "type" && $2 == "mesh point" { print i; exit }')"
[ -n "$mesh_if" ] && result PASS '80211s-mesh-interface' "$mesh_if" || result WARN '80211s-mesh-interface' 'no mesh point interface is up'
ap_if="$(iw dev 2>/dev/null | awk '$1 == "Interface" { i=$2 } $1 == "type" && $2 == "AP" { print i; exit }')"
[ -n "$ap_if" ] && result PASS 'local-ap' "$ap_if" || result WARN 'local-ap' 'no local AP interface is up'

if ip link show eth0 >/dev/null 2>&1; then
	result PASS 'ethernet-uplink' "$(cat /sys/class/net/eth0/operstate 2>/dev/null || echo unknown)"
else
	result WARN 'ethernet-uplink' 'eth0 is not present'
fi
gateway="$(ip route 2>/dev/null | awk '$1 == "default" { print $3; exit }')"
if [ -n "$gateway" ]; then
	result PASS 'default-route' "$gateway"
	if ping -c 1 -W 2 "$gateway" >/dev/null 2>&1; then
		result PASS 'mesh-gateway' "$gateway responds"
	else
		result WARN 'mesh-gateway' "$gateway does not respond"
	fi
	if ping -c 1 -W 2 1.1.1.1 >/dev/null 2>&1; then
		result PASS 'internet-uplink' '1.1.1.1 responds'
	else
		result WARN 'internet-uplink' 'Internet probe did not respond'
	fi
else
	result WARN 'default-route' 'no default route configured'
fi

if [ -d /opt/docker ] && [ -w /opt/docker ]; then
	result PASS 'docker-storage' '/opt/docker is writable'
	if command -v setcap >/dev/null 2>&1 && command -v getcap >/dev/null 2>&1; then
		captest=/opt/docker/.openmanet-cap-test
		if cp /bin/busybox "$captest" 2>/dev/null && setcap cap_net_raw+ep "$captest" 2>/dev/null && getcap "$captest" 2>/dev/null | grep -q cap_net_raw; then
			result PASS 'docker-file-capabilities' 'security.capability xattr works'
		else
			result FAIL 'docker-file-capabilities' 'security.capability xattr is unavailable'
		fi
		rm -f "$captest"
	else
		result WARN 'docker-file-capabilities' 'setcap/getcap not installed'
	fi
else
	result FAIL 'docker-storage' '/opt/docker is not writable'
fi

if command -v docker >/dev/null 2>&1; then
	run 'docker-daemon' docker info
	if [ -f /opt/opentakserver/compose.yaml ] && docker compose -f /opt/opentakserver/compose.yaml ps >/dev/null 2>&1; then
		result PASS 'opentakserver-compose' 'compose project is readable'
	else
		result WARN 'opentakserver-compose' 'project is not ready or has not pulled images'
	fi
else
	result WARN 'docker-daemon' 'docker command is not installed'
fi

printf 'SUMMARY PASS=%s WARN=%s FAIL=%s\n' "$pass" "$warn" "$fail" >> "$OUT"
logger -t openmanet-health "$(tail -n 1 "$OUT")" 2>/dev/null || true
cat "$OUT"
[ "$fail" -eq 0 ]
