#!/bin/sh

set -u

CONFIG=openmanet-node-fixes
MARKER=/etc/openmanet-node-fixes/batman-migrated

log_msg() {
	logger -t openmanet-batman "$*" 2>/dev/null || true
	echo "openmanet-batman: $*"
}

find_mesh_iface() {
	local section="$1" device mode disabled
	config_get device "$section" device
	config_get mode "$section" mode
	config_get_bool disabled "$section" disabled 0
	[ "$mode" = mesh ] || return 0
	[ "$disabled" -eq 0 ] || return 0
	[ -n "$device" ] || return 0
	mesh_iface_sections="${mesh_iface_sections} ${section}"
}

find_bridge_section() {
	local section="$1" type name
	config_get type "$section" type
	config_get name "$section" name
	[ "$type" = bridge ] || return 0
	[ "$name" = br-ahwlan ] || return 0
	ahwlan_bridge="$section"
}

add_bridge_port() {
	local section="$1" ports
	[ -n "$section" ] || return 0
	ports="$(uci -q get network.${section}.ports 2>/dev/null || true)"
	case " ${ports} " in
		*" bat0 "*) ;;
		*) uci add_list network.${section}.ports='bat0' ;;
	esac
}

repair() {
	local enabled repair disabled gate iface index hardif
	config_load "$CONFIG"
	config_get_bool enabled main enabled 1
	config_get_bool repair main repair_batman 1
	[ "$enabled" -eq 1 ] && [ "$repair" -eq 1 ] || return 0

	mesh_iface_sections=""
	config_load wireless
	config_foreach find_mesh_iface wifi-iface
	[ -n "$mesh_iface_sections" ] || {
		log_msg 'no enabled 802.11s mesh interface found; leaving network unchanged'
		return 0
	}

	disabled="$(uci -q get network.bat0.disabled 2>/dev/null || true)"
	gate="$(uci -q get mesh11sd.mesh_params.mesh_gate_announcements 2>/dev/null || true)"
	# Do not touch a fresh/default configuration. The OpenMANET wizard records
	# the gate/point decision in mesh_gate_announcements; that explicit value is
	# the only signal that mesh routing should be enabled automatically.
	case "$gate" in
		0|1) ;;
		*)
			log_msg 'no OpenMANET mesh role selected; leaving network unchanged'
			return 0
			;;
	esac
	if [ "$disabled" = 1 ]; then
		log_msg 'mesh role selected; clearing stale bat0 disabled flag'
	fi

	uci -q set network.bat0='interface'
	uci set network.bat0.proto='batadv'
	uci set network.bat0.routing_algo='BATMAN_V'
	uci set network.bat0.multicast_mode='0'
	uci set network.bat0.bridge_loop_avoidance='1'
	uci set network.bat0.hop_penalty='30'
	uci set network.bat0.orig_interval='1000'
	uci set network.bat0.distributed_arp_table='1'
	uci -q delete network.bat0.disabled
	case "$gate" in
		1) uci set network.bat0.gw_mode='server' ;;
		0) uci set network.bat0.gw_mode='client' ;;
	esac

	index=0
	for iface in $mesh_iface_sections; do
		hardif="batmesh${index}"
		uci -q set network.${hardif}='interface'
		uci set network.${hardif}.proto='batadv_hardif'
		uci set network.${hardif}.master='bat0'
		# This is the discovered wifi-iface section, not a hardcoded wlan name.
		# The physical mesh must never be bridged directly.
		uci set wireless.${iface}.network="$hardif"
		index=$((index + 1))
	done

	uci -q set mesh11sd.mesh_params.mesh_fwding='0'
	uci -q set mesh11sd.mesh_params.nolearn='1'
	ahwlan_bridge=""
	config_load network
	config_foreach find_bridge_section device
	add_bridge_port "$ahwlan_bridge"
	uci commit network
	uci commit wireless
	uci commit mesh11sd

	mkdir -p "$(dirname "$MARKER")"
	date -u +%s > "$MARKER"
	log_msg "repaired BATMAN-V topology (${index} mesh hard interface(s), role=${gate:-unspecified})"
}

case "${1:-repair}" in
	repair) repair ;;
	*) echo "usage: $0 repair" >&2; exit 2 ;;
esac
