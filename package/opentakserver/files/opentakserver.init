#!/bin/sh /etc/rc.common

START=96
USE_PROCD=1

DATA_ROOT=/opt/opentakserver

load_config() {
	. /lib/functions.sh
	config_load opentakserver
	config_get enabled main enabled '1'
	config_get DATA_ROOT main data_root "$DATA_ROOT"
}

start_service() {
	load_config
	[ "$enabled" = '1' ] || return 0
	command -v docker >/dev/null 2>&1 || return 0

	procd_open_instance
	procd_set_param command /bin/sh -c 'i=0; while [ ! -S /var/run/docker.sock ] && [ "$i" -lt 60 ]; do i=$((i + 1)); sleep 2; done; [ -S /var/run/docker.sock ] || exit 1; exec /usr/sbin/opentakserver-setup run'
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	load_config
	command -v docker >/dev/null 2>&1 || return 0
	[ -f "$DATA_ROOT/compose.yaml" ] || return 0
	docker compose -f "$DATA_ROOT/compose.yaml" down || true
}

service_triggers() {
	procd_add_reload_trigger opentakserver
}
